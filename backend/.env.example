# .env.example — Copy this to .env and fill in real values. DO NOT commit .env to git.

# Supabase (from Project Settings > Database)
SUPABASE_DB_URL=jdbc:postgresql://YOUR_HOST.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Firebase (from Project Settings > Service Accounts > Generate new private key, then base64 encode the JSON)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json

# Groq AI (from console.groq.com > API Keys)
GROQ_API_KEY=gsk_your_groq_api_key

# Razorpay (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# JWT (generate a secure 256-bit random string)
JWT_SECRET=your_256_bit_random_jwt_secret_here

# CORS (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
