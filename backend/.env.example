# ═══════════════════════════════════════════════════════════════════════════
# AI Study Planner — Backend Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Allowed CORS Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=https://ai-study-planner.vercel.app,http://localhost:3000,https://ai-study-planner-hp0e.onrender.com

# Firebase Authentication
FIREBASE_PROJECT_ID=study-planner-ec1d2
FIREBASE_SERVICE_ACCOUNT_JSON=base64_or_json_encoded_service_account

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key

# JWT Secret (HS256 Secret for backend authentication cookies)
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Supabase PostgreSQL Database (Transaction pooler or direct)
SUPABASE_DB_URL=jdbc:postgresql://your-pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_database_password

# Supabase Storage & API Keys
SUPABASE_URL=https://your_project_ref.supabase.co
# SUPABASE_ANON_KEY is the public 'anon' key (safe for browser uploads with user auth)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY is the admin key for service-level operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
