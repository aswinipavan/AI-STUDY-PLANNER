# .env.example — Copy this to .env and fill in real values. DO NOT commit .env to git.

# Supabase (from Project Settings > Database)
SUPABASE_DB_URL=jdbc:postgresql://<your-supabase-host>:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=<your-supabase-db-password>
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Firebase (from Project Settings > Service Accounts > Generate new private key, then base64 encode the JSON)
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=<base64-encoded-service-account-json>

# Groq AI (from console.groq.com > API Keys)
GROQ_API_KEY=<your-groq-api-key>

# Razorpay (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>

# JWT (generate a secure 256-bit random string)
JWT_SECRET=<your-256-bit-random-jwt-secret>

# CORS (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:3000
