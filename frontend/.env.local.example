# .env.local (git-ignored — copy this file to .env.local and fill in real values)

# --- Backend API ---
NEXT_PUBLIC_BACKEND_URL=https://ai-study-planner-hp0e.onrender.com

# --- Firebase (NEXT_PUBLIC_ — required on client for Google Sign-In) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Razorpay (Key ID ONLY — secret stays on backend) ---
# Use rzp_test_... for testing, rzp_live_... for production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
