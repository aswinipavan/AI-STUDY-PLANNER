# .env.example — Copy to .env and fill values. NEVER commit .env to git.
BACKEND_URL=https://aistudyplannerbackend.onrender.com

FIREBASE_API_KEY=<your-firebase-api-key>
FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<sender-id>
FIREBASE_APP_ID=1:<sender-id>:android:<android-app-id>

RAZORPAY_KEY_ID=rzp_test_...
