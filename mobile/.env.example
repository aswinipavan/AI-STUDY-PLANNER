# .env.example — Copy to .env and fill values. NEVER commit .env to git.

# Reference only. Nothing under mobile/src reads process.env, so this value has no
# effect at runtime — the URL that actually ships is hardcoded in
# mobile/src/constants/config.ts. Keep the two in sync, and change that file when
# the backend moves.
BACKEND_URL=https://ai-study-planner-hp0e.onrender.com

FIREBASE_API_KEY=<your-firebase-api-key>
FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<sender-id>
FIREBASE_APP_ID=1:<sender-id>:android:<android-app-id>

RAZORPAY_KEY_ID=rzp_test_...
