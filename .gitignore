# ─────────────────────────────────────────────
#  ROOT .gitignore — AI Study Planner
# ─────────────────────────────────────────────

# ── Secrets / Environment Files ──────────────
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.local.example

# Service account keys (Firebase, GCP, etc.)
serviceAccountKey.json
*serviceAccount*.json
*.pem
google-services.json

# ── Backend (Spring Boot / Maven) ────────────
backend/target/
backend/logs/
backend/*.log
backend/full_test_output.txt
backend/test_output.txt
backend/maven.zip
backend/maven/

# ── Frontend (Next.js / Node) ─────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel/

# ── IDE / Editor ─────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────
*.log
logs/

# ── Python / Testing Caches ──────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
test-results/
frontend/test-results/
frontend/playwright-report/

# ── OS Files ─────────────────────────────────
.DS_Store
Thumbs.db

# ── Local tooling ────────────────────────────
# Per-machine Claude Code permissions. launch.json IS tracked — it is the shared
# dev-server config — but this file records one developer's approvals.
.claude/settings.local.json

# Scratch output from `npm run lint > …`. Regenerate it, don't commit it.
frontend/lint_results.txt

# Scratch scripts
scratch/

# ── Mobile (React Native / Android) ──────────
mobile/node_modules/
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/*.log


